# Copy to .env.local and replace every value before the first real test.
# Production on Vercel needs all of the required variables below.

# Turso libSQL URL. Local default is a SQLite file.
DATABASE_URL=file:./data/masten.db
# DATABASE_URL=libsql://your-database-name.turso.io
# Required when DATABASE_URL is libsql:// or https://
DATABASE_AUTH_TOKEN=

# Vercel Blob. Required in production. Leave empty locally to use data/uploads.
BLOB_READ_WRITE_TOKEN=

# Bearer token for the Lifesaver intake API. Required in production.
INTAKE_API_KEY=replace-with-a-long-random-key

# Signs the staff session cookie. At least 32 random characters in production.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Shop admin, created on the first migration. Later runs do not change the password.
ADMIN_EMAIL=you@mastenonline.com
ADMIN_PASSWORD=replace-with-a-real-password
# Optional display name. Defaults to "Shop admin".
# ADMIN_NAME=Jenny Riemer
